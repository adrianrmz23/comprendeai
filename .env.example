# Copia este archivo como .env.local para usar IA también con `npm run dev`.
# En Vercel agrega las mismas variables en Project Settings > Environment Variables.
# IMPORTANTE: nunca uses el prefijo VITE_ para la API key.
OPENAI_API_KEY=

# Modelo económico por defecto para explicaciones y sesiones.
OPENAI_MODEL=gpt-5.6-luna

# Opcional pero recomendado para el motor semántico del Bloque 6.
# Token de Hugging Face con permiso de Inference Providers.
HF_TOKEN=

# BGE-M3 es el modelo preferido por su soporte multilingüe y contexto largo.
HF_EMBEDDING_MODEL=BAAI/bge-m3


# ──────────────────────────────────────────────────────────────────────────────
# Comprende 2.0 · Auth + sincronización + caché persistente + ElevenLabs
# Navegador: login y datos protegidos por RLS. Estas variables SÍ llevan VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alternativa: Comprende 2.0 también acepta tus nombres existentes de Next.js:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Servidor: caché IA, ElevenLabs y Storage privado. NO llevan VITE_.
# SUPABASE_URL suele tener exactamente el mismo valor que VITE_SUPABASE_URL.
# Si ya defines NEXT_PUBLIC_SUPABASE_URL, el backend de Comprende 2.0 también puede reutilizarla.
SUPABASE_URL=
# Prefer the new Supabase server secret key (Settings > API Keys).
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs. La voz se genera una sola vez por texto/voz/modelo y luego se reutiliza
# desde el bucket privado comprende-v1-elevenlabs-audio de Supabase Storage.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128


# ──────────────────────────────────────────────────────────────────────────────
# Comprende 2.0 · Router para escenarios y Generic Lab Composer
# Los cálculos SIEMPRE ocurren en TypeScript. Estas IA solo crean narrativas/casos.
# Valores: auto | openai | deepseek | cheapinference
LAB_AI_PROVIDER=auto

# DeepSeek (opcional). Define el endpoint OpenAI-compatible que uses en tu cuenta.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# CheapInference (opcional). Se deja base URL/modelo explícitos para no asumir proveedor.
CHEAPINFERENCE_API_KEY=
CHEAPINFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPINFERENCE_MODEL=deepseek-v4-flash-0731

# Comprende 2.0 · modelo avanzado para rescate/profundización
# La explicación normal sigue usando OPENAI_MODEL; solo se usa al pedir profundización.
OPENAI_DEEP_MODEL=gpt-5.6-sol
