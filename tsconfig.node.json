{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "api/**/*.ts",
    "src/labs/genericEngine.ts",
    "src/labs/types.ts"
  ]
}
